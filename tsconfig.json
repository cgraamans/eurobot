{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution":"bundler",
        "esModuleInterop": true,
        "target": "es6",
        "noImplicitAny": true,
        "sourceMap": true,
        "skipLibCheck":true,
        "outDir": "Z:/www/eurobot/dist",
        "paths": {
            "*": [
                "./node_modules/",
                "./types/*"
            ]
        },
        "types":["node"]
    },
    "include": [
        "src/**/*",
        "*.ts",
        "types/**/*.d.ts"
    ]
}
